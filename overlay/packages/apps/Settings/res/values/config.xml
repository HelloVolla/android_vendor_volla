<resources>
    <!-- Whether to display Cloned Apps page in Settings (Settings > Apps > Cloned apps) -->
    <bool name="config_cloned_apps_page_enabled">true</bool>

    <!-- Whether memory from app_info_settings is available or not. -->
    <bool name="config_show_app_info_settings_memory">true</bool>

    <!-- Whether to show the "glanceable hub" settings. -->
    <bool name="config_show_glanceable_hub_toggle_setting">true</bool>

    <!-- Whether to show the "glanceable hub" settings on mobile. -->
    <bool name="config_show_glanceable_hub_toggle_setting_mobile">true</bool>
</resources>
