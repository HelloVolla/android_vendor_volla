+ package com.android.settings.applications;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.BasePreferenceController;
+
+public class MicrogController extends BasePreferenceController {
+
+    public static final String KEY = "enable_microg";
+
+    private Context mContext;
+
+    public MicrogController(Context context, String key) {
+        super(context, key);
+
+        mContext = context;
+    }
+
+    public MicrogController(Context context) {
+        this(context, KEY);
+
+        mContext = context;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        boolean applock = SystemProperties.getBoolean("persist.volla.applock.enable", false);
+        boolean linkmicrog = SystemProperties.getBoolean("persist.volla.linkmicrog", false);
+
+        return ((applock && linkmicrog) ? DISABLED_DEPENDENT_SETTING : AVAILABLE);
+    }
+
+}
