From d77a94bd17d3991a5e96721a42c7ce16d72b36ef Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Fri, 19 Jul 2024 17:19:34 +0330
Subject: [PATCH] LegalSettings: Move legal_url to resources

Change-Id: I1270ff984b2c4143c3c1477896004a775ca2d848
---
 res/values/volla_strings.xml                         |  6 ++++++
 .../deviceinfo/legal/LineageLegalPreference.kt       | 12 +++++-------
 2 files changed, 11 insertions(+), 7 deletions(-)
 create mode 100644 res/values/volla_strings.xml

diff --git a/res/values/volla_strings.xml b/res/values/volla_strings.xml
new file mode 100644
index 00000000000..543d1a5f581
--- /dev/null
+++ b/res/values/volla_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Legal -->
+    <string name="lineage_legal_url">https://lineageos.org/legal</string>
+
+</resources>
diff --git a/src/com/android/settings/deviceinfo/legal/LineageLegalPreference.kt b/src/com/android/settings/deviceinfo/legal/LineageLegalPreference.kt
index a6b198d36e4..abea7fe0bfc 100644
--- a/src/com/android/settings/deviceinfo/legal/LineageLegalPreference.kt
+++ b/src/com/android/settings/deviceinfo/legal/LineageLegalPreference.kt
@@ -24,19 +24,17 @@ import com.android.settingslib.metadata.PreferenceAvailabilityProvider
 import com.android.settingslib.metadata.PreferenceMetadata
 import com.android.settingslib.metadata.PreferenceTitleProvider
 
+import com.android.settings.R
+
 class LineageLegalPreference(override val key: String, @StringRes val defaultTitle: Int = 0) :
     PreferenceMetadata, PreferenceTitleProvider, PreferenceAvailabilityProvider {
 
-    private companion object {
-        const val PROPERTY_LINEAGE_LICENSE_URL = "ro.lineagelegal.url"
-    }
-
-    private fun getLicenseUrl(): String = SystemProperties.get(PROPERTY_LINEAGE_LICENSE_URL)
+    private fun getLicenseUrl(context: Context): String = context.getString(R.string.lineage_legal_url)
 
     override fun getTitle(context: Context): CharSequence? = context.getText(defaultTitle)
 
     override fun isAvailable(context: Context): Boolean {
-        val url = getLicenseUrl()
+        val url = getLicenseUrl(context)
         if (url.isNullOrBlank()) return false
 
         val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
@@ -44,7 +42,7 @@ class LineageLegalPreference(override val key: String, @StringRes val defaultTit
     }
 
     override fun intent(context: Context): Intent? {
-        val url = getLicenseUrl()
+        val url = getLicenseUrl(context)
         return if (url.isNotBlank()) {
             Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
         } else null
