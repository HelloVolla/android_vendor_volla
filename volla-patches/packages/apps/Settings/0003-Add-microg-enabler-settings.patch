From: Erfan Abdi <erfangplus@gmail.com>
Date: Fri, 19 Jul 2024 17:39:21 +0330
Subject: [PATCH] Add microg enabler settings

Change-Id: Id6ca2cb774b4c0f621a2e2a1c0e368b11c57d86c
---
 res/values/volla_strings.xml | 3 +++
 res/xml/apps.xml             | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/res/values/volla_strings.xml b/res/values/volla_strings.xml
index 543d1a5f581..21d817fac2d 100644
--- a/res/values/volla_strings.xml
+++ b/res/values/volla_strings.xml
@@ -3,4 +3,7 @@
     <!-- Legal -->
     <string name="lineage_legal_url">https://lineageos.org/legal</string>
 
+    <string name="enable_microg_title">Manage MicroG</string>
+    <string name="enable_microg_summary">Enable or disable MicroG</string>
+
 </resources>
diff --git a/res/xml/apps.xml b/res/xml/apps.xml
index c4313f645e4..10526cbfd9d 100644
--- a/res/xml/apps.xml
+++ b/res/xml/apps.xml
@@ -75,6 +75,13 @@
         <intent android:action="android.settings.MANAGE_CLONED_APPS_SETTINGS"/>
     </Preference>
 
+    <lineageos.preference.LineageSystemSettingSwitchPreference
+        android:key="enable_microg"
+        android:title="@string/enable_microg_title"
+        android:summary="@string/enable_microg_summary"
+        android:order="-994"
+        android:defaultValue="false" />
+
     <PreferenceCategory
         android:key="dashboard_tile_placeholder"
         android:order="10"/>
