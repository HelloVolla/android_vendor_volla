From bb9722d16e7eb37863b2aed6f8d8c1de62500ee9 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Sun, 12 Nov 2023 16:48:28 +0330
Subject: [PATCH] volla: Move bootanimation to volla vendor

Change-Id: Ide5217d84e10a15a62a7cd33869df079a72cdddf
---
 bootanimation/Android.mk        |  66 --------------------------------
 bootanimation/CleanSpec.mk      |  17 --------
 bootanimation/bootanimation.tar | Bin 10265600 -> 0 bytes
 bootanimation/desc.txt          |   5 ---
 4 files changed, 88 deletions(-)
 delete mode 100644 bootanimation/Android.mk
 delete mode 100644 bootanimation/CleanSpec.mk
 delete mode 100644 bootanimation/bootanimation.tar
 delete mode 100644 bootanimation/desc.txt

diff --git a/bootanimation/Android.mk b/bootanimation/Android.mk
deleted file mode 100644
index f58a850f..00000000
--- a/bootanimation/Android.mk
+++ /dev/null
@@ -1,66 +0,0 @@
-#
-# Copyright (C) 2016 The CyanogenMod Project
-#               2017-2019 The LineageOS Project
-#
-# Licensed under the Apache License, Version 2.0 (the "License");
-# you may not use this file except in compliance with the License.
