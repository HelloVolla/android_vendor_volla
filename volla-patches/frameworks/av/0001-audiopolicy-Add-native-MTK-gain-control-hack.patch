From 5b7af34377f8bfe53787643e8bbf67abccbedb02 Mon Sep 17 00:00:00 2001
From: bengris32 <bengris32@protonmail.ch>
Date: Mon, 8 Apr 2024 01:33:07 +0100
Subject: [PATCH] audiopolicy: Add native MTK gain control hack

Change-Id: Ied8f8c39c29608cd6bbff008707d6f89a85d737c
Signed-off-by: bengris32 <bengris32@protonmail.ch>
---
 .../managerdefault/AudioPolicyManager.cpp           | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
index f625fdb3be..c3dd13d614 100644
--- a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
+++ b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
@@ -7337,6 +7337,7 @@ status_t AudioPolicyManager::checkAndSetVolume(IVolumeCurves &curves,
     VolumeSource btScoVolSrc = toVolumeSource(AUDIO_STREAM_BLUETOOTH_SCO, false);
     bool isVoiceVolSrc = (volumeSource != VOLUME_SOURCE_NONE) && (callVolSrc == volumeSource);
     bool isBtScoVolSrc = (volumeSource != VOLUME_SOURCE_NONE) && (btScoVolSrc == volumeSource);
+    bool needGainHack = (isVoiceVolSrc || isBtScoVolSrc);
 
     bool isScoRequested = isScoRequestedForComm();
     bool isHAUsed = isHearingAidUsedForComm();
@@ -7385,6 +7386,18 @@ status_t AudioPolicyManager::checkAndSetVolume(IVolumeCurves &curves,
             mLastVoiceVolume = voiceVolume;
         }
     }
+
+    if (needGainHack) {
+        AudioParameter param;
+        param.addInt(String8("volumeStreamType"),
+            isVoiceVolSrc ? AUDIO_STREAM_VOICE_CALL : AUDIO_STREAM_BLUETOOTH_SCO);
+        param.addInt(String8("volumeDevice"), deviceTypesToBitMask(deviceTypes));
+        param.addInt(String8("volumeIndex"), index);
+
+        mpClientInterface->setParameters(mPrimaryOutput->mIoHandle,
+                                        param.toString());
+    }
+
     return NO_ERROR;
 }
 
