From 6af4d2575f82edcf8a0b4363698f49bb025d87f7 Mon Sep 17 00:00:00 2001
From: Aryan Sinha <techyminati@outlook.com>
Date: Fri, 27 Jun 2025 17:03:13 +0000
Subject: [PATCH 1/2] audiopolicy: Add native MTK gain control hack

Change-Id: Ia0f3d6433acf8375cf0e6c4c15c98e35b3553d7a
---
 .../audiopolicy/managerdefault/AudioPolicyManager.cpp     | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
index f133dfa..4c15c85 100644
--- a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
+++ b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
@@ -8643,6 +8643,14 @@ status_t AudioPolicyManager::checkAndSetVolume(IVolumeCurves &curves,
         bool voiceVolumeManagedByHost = !isBtScoVolSrc &&
                 !isSingleDeviceType(deviceTypes, audio_is_ble_out_device);
         setVoiceVolume(index, curves, voiceVolumeManagedByHost, delayMs);
+        AudioParameter param;
+        param.addInt(String8("volumeStreamType"),
+            isVoiceVolSrc ? AUDIO_STREAM_VOICE_CALL : AUDIO_STREAM_BLUETOOTH_SCO);
+        param.addInt(String8("volumeDevice"), deviceTypesToBitMask(deviceTypes));
+        param.addInt(String8("volumeIndex"), index);
+
+        mpClientInterface->setParameters(mPrimaryOutput->mIoHandle,
+                                        param.toString());
     }
     return NO_ERROR;
 }
