From 93793785ed44d280700b863ef3f820e9c4d550f3 Mon Sep 17 00:00:00 2001
From: Aryan Sinha <aryan.sinha@volla.online>
Date: Sun, 5 Jan 2025 17:53:46 +0000
Subject: [PATCH] Fix MicroG Spoofing

Change-Id: I516b26e5fb5ddb7d19ead15b0a979ab394a91aea
Signed-off-by: Aryan Sinha <aryan.sinha@volla.online>
---
 .../com/android/server/pm/ComputerEngine.java   | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/pm/ComputerEngine.java b/services/core/java/com/android/server/pm/ComputerEngine.java
index 4960a9365073..17f52a070ac3 100644
--- a/services/core/java/com/android/server/pm/ComputerEngine.java
+++ b/services/core/java/com/android/server/pm/ComputerEngine.java
@@ -160,7 +160,7 @@ import com.android.server.utils.WatchedLongSparseArray;
 import com.android.server.utils.WatchedSparseBooleanArray;
 import com.android.server.utils.WatchedSparseIntArray;
 import com.android.server.wm.ActivityTaskManagerInternal;
-
+import java.security.cert.CertificateException;
 import libcore.util.EmptyArray;
 
 import java.io.BufferedOutputStream;
@@ -1543,6 +1543,21 @@ public class ComputerEngine implements Computer {
                 return null;
             }
 
+            if (isMicroG) {
+                try {
+                    packageInfo.signingInfo = new SigningInfo(
+                            new SigningDetails(
+                                    packageInfo.signatures,
+                                    SigningDetails.SignatureSchemeVersion.SIGNING_BLOCK_V3,
+                                    SigningDetails.toSigningKeys(packageInfo.signatures),
+                                    null
+                            )
+                    );
+                } catch (CertificateException e) {
+                    Slog.e(TAG, "Caught an exception when creating signing keys: ", e);
+                }
+            }
+
             packageInfo.packageName = packageInfo.applicationInfo.packageName =
                     resolveExternalPackageName(p);
 
-- 
