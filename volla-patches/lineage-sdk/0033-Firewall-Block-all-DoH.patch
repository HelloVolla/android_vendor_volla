+package org.lineageos.platform.internal;
+
+/**
+ * Domains belonging to known DNS-over-HTTPS (DoH) providers.
+ *
+ * When the firewall is active these are always redirected to 127.0.0.1 via
+ * dnsmasq regardless of blacklist/whitelist mode, so that apps cannot bypass
+ * domain-level blocking by switching to an encrypted DNS resolver.
+ */
+final class KnownDohDomains {
+
+    // Cloudflare
+    static final String[] CLOUDFLARE = {
+        "cloudflare-dns.com",
+        "1dot1dot1dot1.cloudflare-dns.com",
+        "dns.cloudflare.com",
+        "mozilla.cloudflare-dns.com",
+        "security.cloudflare-dns.com",
+        "family.cloudflare-dns.com",
+    };
+
+    // Google
+    static final String[] GOOGLE = {
+        "dns.google",
+        "dns.google.com",
+        "doh.dns.google",
+        "dns64.dns.google",
+    };
+
+    // Quad9
+    static final String[] QUAD9 = {
+        "dns.quad9.net",
+        "doh.quad9.net",
+        "dns10.quad9.net",
+        "dns11.quad9.net",
+    };
+
+    // NextDNS
+    static final String[] NEXTDNS = {
+        "dns.nextdns.io",
+        "nextdns.io",
+    };
+
+    // AdGuard
+    static final String[] ADGUARD = {
+        "dns.adguard.com",
+        "dns.adguard-dns.com",
+        "dns-family.adguard.com",
+        "dns-unfiltered.adguard.com",
+        "unfiltered.adguard-dns.com",
+        "family.adguard-dns.com",
+    };
+
+    // Cisco / OpenDNS
+    static final String[] OPENDNS = {
+        "doh.opendns.com",
+        "doh.familyshield.opendns.com",
+    };
+
+    // CleanBrowsing
+    static final String[] CLEANBROWSING = {
+        "doh.cleanbrowsing.org",
+        "family-filter-dns.cleanbrowsing.org",
+        "adult-filter-dns.cleanbrowsing.org",
+        "security-filter-dns.cleanbrowsing.org",
+    };
+
+    // Mullvad
+    static final String[] MULLVAD = {
+        "dns.mullvad.net",
+        "adblock.dns.mullvad.net",
+        "base.dns.mullvad.net",
+        "extended.dns.mullvad.net",
+        "all.dns.mullvad.net",
+    };
+
+    // ControlD
+    static final String[] CONTROLD = {
+        "freedns.controld.com",
+        "dns.controld.com",
+        "p0.freedns.controld.com",
+    };
+
+    // Comcast
+    static final String[] COMCAST = {
+        "doh.xfinity.com",
+    };
+
+    // Alibaba
+    static final String[] ALIBABA = {
+        "dns.alidns.com",
+    };
+
+    // DNSPod / Tencent
+    static final String[] DNSPOD = {
+        "doh.pub",
+        "dns.pub",
+    };
+
+    // SWITCH (Switzerland)
+    static final String[] SWITCH = {
+        "dns.switch.ch",
+    };
+
+    // LibreDNS
+    static final String[] LIBREDNS = {
+        "doh.libredns.gr",
+    };
+
+    // Digitale Gesellschaft (Switzerland)
+    static final String[] DIGITALE = {
+        "dns.digitale-gesellschaft.ch",
+    };
+
+    // DNS.SB
+    static final String[] DNSSB = {
+        "doh.dns.sb",
+        "dns.sb",
+    };
+
+    // BlahDNS
+    static final String[] BLAHDNS = {
+        "doh-de.blahdns.com",
+        "doh-jp.blahdns.com",
+        "doh-fi.blahdns.com",
+        "doh-sg.blahdns.com",
+    };
+
+    // Dnswarden
+    static final String[] DNSWARDEN = {
+        "doh.dnswarden.com",
+    };
+
+    // OpenBSD / dns0.eu
+    static final String[] DNS0EU = {
+        "dns0.eu",
+        "zero.dns0.eu",
+        "kids.dns0.eu",
+        "open.dns0.eu",
+    };
+
+    // AhaDNS
+    static final String[] AHADNS = {
+        "doh.ahadns.com",
+        "doh.nl.ahadns.net",
+        "doh.in.ahadns.net",
+    };
+
+    // Consolidated flat array used by resetDnsConf().
+    static final String[] ALL;
+
+    static {
+        // Count total
+        int total = CLOUDFLARE.length + GOOGLE.length + QUAD9.length
+            + NEXTDNS.length + ADGUARD.length + OPENDNS.length
+            + CLEANBROWSING.length + MULLVAD.length + CONTROLD.length
+            + COMCAST.length + ALIBABA.length + DNSPOD.length
+            + SWITCH.length + LIBREDNS.length + DIGITALE.length
+            + DNSSB.length + BLAHDNS.length + DNSWARDEN.length
+            + DNS0EU.length + AHADNS.length;
+
+        ALL = new String[total];
+        int i = 0;
+        for (String[] group : new String[][]{
+            CLOUDFLARE, GOOGLE, QUAD9, NEXTDNS, ADGUARD, OPENDNS,
+            CLEANBROWSING, MULLVAD, CONTROLD, COMCAST, ALIBABA, DNSPOD,
+            SWITCH, LIBREDNS, DIGITALE, DNSSB, BLAHDNS, DNSWARDEN,
+            DNS0EU, AHADNS
+        }) {
+            for (String d : group) ALL[i++] = d;
+        }
+    }
+
+    private KnownDohDomains() {}
+}
-- 
