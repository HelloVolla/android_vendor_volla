From 09730a59f591be2806491469b85a0b3eda17d3d3 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Wed, 25 Feb 2026 10:10:25 +0330
Subject: [PATCH]  Make microg link toggle independent of applock

Change-Id: Id6cd4dbefff11d33ceaf23a432377d2e61913ded
---
 .../org/lineageos/platform/internal/AppLockService.java  | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/AppLockService.java b/lineage/lib/main/java/org/lineageos/platform/internal/AppLockService.java
index acd612cf..0ae52f67 100644
--- a/lineage/lib/main/java/org/lineageos/platform/internal/AppLockService.java
+++ b/lineage/lib/main/java/org/lineageos/platform/internal/AppLockService.java
@@ -283,10 +283,13 @@ public class AppLockService extends LineageSystemService {
                 PackageManager.COMPONENT_ENABLED_STATE_DISABLED :
                 PackageManager.COMPONENT_ENABLED_STATE_ENABLED, 0);
         }
-        SystemProperties.set("persist.volla.applock.enable", enable ? "true" : "false");
-        if (isLinkMicroGEnabled())
+        if (isLinkMicroGEnabled() && (isActivate() != enable)) {
+            int value = LineageSettings.System.getIntForUser(mContext.getContentResolver(),
+                    LineageSettings.System.ENABLE_MICROG, 0, UserHandle.USER_CURRENT);
             LineageSettings.System.putIntForUser(mContext.getContentResolver(),
-                    LineageSettings.System.ENABLE_MICROG, enable ? 0 : 1, UserHandle.USER_CURRENT);
+                    LineageSettings.System.ENABLE_MICROG, (value == 1) ? 0 : 1, UserHandle.USER_CURRENT);
+        }
+        SystemProperties.set("persist.volla.applock.enable", enable ? "true" : "false");
     }
 
     public boolean isActivate() {
-- 
