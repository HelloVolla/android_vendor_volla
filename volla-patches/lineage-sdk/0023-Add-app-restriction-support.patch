+            mHandler.sendEmptyMessage(FirewallHandler.MSG_WRITE_APPS_STATE);
+        }
+    }
+
+    private void removeAppFromList(String app) {
+        if (mAppsList.contains(app)) {
+            mAppsList.remove(app);
+            mHandler.sendEmptyMessage(FirewallHandler.MSG_WRITE_APPS_STATE);
+        }
+    }
+
+    public boolean isAppOnList(String app) {
