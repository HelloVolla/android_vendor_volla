From 840456b4fe5731ee0a9b52447b100d587ab4439b Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Sun, 10 Aug 2025 12:15:58 +0330
Subject: [PATCH] Update roboto json

---
 font_config.json | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/font_config.json b/font_config.json
index 5e46ece..966bc2d 100644
--- a/font_config.json
+++ b/font_config.json
@@ -3,8 +3,17 @@
         "name": "sans-serif",
         "fonts": [
             {
-                "file": "Roboto-Regular.ttf",
-                "supportedAxes": "wght,ital",
+                "file": "NotoSans-VariableFont.ttf",
+                "style": "normal",
+                "supportedAxes": "wght",
+                "axes": {
+                    "wdth": "100"
+                }
+            },
+            {
+                "file": "NotoSans-Italic-VariableFont.ttf",
+                "style": "italic",
+                "supportedAxes": "wght",
                 "axes": {
                     "wdth": "100"
                 }
